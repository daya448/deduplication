# Copy this file to .env and fill in your credentials
# .env is gitignored - never commit your actual credentials!

# Elasticsearch (from https://cloud.elastic.co/deployments)
ELASTIC_CLOUD_ID=your_elastic_cloud_id
ELASTIC_API_KEY=your_elastic_api_key
ELASTIC_INDEX_NAME=names-search

# Azure OpenAI (for LLM duplicate analysis)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Optional: Use local Ollama instead of Azure (set OLLAMA_BASE_URL)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
